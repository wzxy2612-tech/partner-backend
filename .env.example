OWNER_DATABASE_URL=postgresql+psycopg://app_owner:owner_pw@localhost:5432/partner_backend
RUNTIME_DATABASE_URL=postgresql+psycopg://app_runtime:runtime_pw@localhost:5432/partner_backend
PLATFORM_DATABASE_URL=postgresql+psycopg://app_platform:platform_pw@localhost:5432/partner_backend


# AES-256-GCM keys for outbox token payloads: `version:hex` pairs, 32 bytes each.
# There is no default and no fallback -- the application refuses to start
# without this, because a key that can be inferred is a key an attacker can
# infer too. Generate one with:  openssl rand -hex 32
#
# Left unset on purpose. A working value here would be copy-pasted into real
# deployments, which is precisely how the all-zero key got shipped.
OUTBOX_KEYS=

# Which version new payloads are written under. Optional while the keyring holds
# exactly one key. Adding a second key makes this REQUIRED -- that is the moment
# the question needs asking, so the configuration becomes invalid until it is
# answered rather than silently continuing to use the old key.
#   OUTBOX_KEYS=1:<old hex>,2:<new hex>
#   OUTBOX_CURRENT_KEY_VERSION=2
OUTBOX_CURRENT_KEY_VERSION=
